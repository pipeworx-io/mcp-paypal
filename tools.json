    "name": "paypal_list_transactions",
    "description": "Find PayPal transactions within a date range. Returns amount, status, payer info, and transaction IDs. Use to audit payments or track cash flow.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "_clientId": {
          "type": "string",
          "description": "PayPal app Client ID"
        },
        "_clientSecret": {
          "type": "string",
          "description": "PayPal app Client Secret"
        },
        "_sandbox": {
          "type": "boolean",
          "description": "Use sandbox environment (default: false)"
        },
        "start_date": {
          "type": "string",
          "description": "Start date in ISO 8601 format (e.g., 2024-01-01T00:00:00Z)"
        },
        "end_date": {
          "type": "string",
          "description": "End date in ISO 8601 format (e.g., 2024-12-31T23:59:59Z)"
        }
      },
      "required": [
        "_clientId",
        "_clientSecret",
        "start_date",
        "end_date"
      ]
    }
  },
